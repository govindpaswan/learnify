# =============================================
# LEARNIFY - Environment Variables
# Copy these to Render Dashboard → Environment
# =============================================

PORT=10000
NODE_ENV=production

# MongoDB Atlas (required)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/learnify?retryWrites=true&w=majority

# JWT (required - use a strong random string)
JWT_SECRET=learnify_super_secret_minimum_32_chars_change_this
JWT_EXPIRE=30d

# Cloudinary (required for image/video uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (required for payments)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Email - Gmail App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=Learnify <your_email@gmail.com>

# Your Render app URL (set after first deploy)
CLIENT_URL=https://learnify.onrender.com

# Admin credentials
ADMIN_EMAIL=admin@learnify.com
ADMIN_PASSWORD=YourSecureAdminPassword123!
